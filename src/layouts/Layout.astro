---
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { profile } from "../data/portfolio";
import { getLangFromUrl, localizedPath } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const { title, description } = Astro.props;

const defaultTitle = `${profile.name} — ${lang === "es" ? "Desarrollador Full-Stack" : "Full-Stack Developer"}`;
const pageTitle = title ?? defaultTitle;
const pageDescription =
  description ??
  (lang === "es"
    ? "Portafolio de Diego Vergara, desarrollador full-stack y entusiasta de la ciberseguridad en Santiago, Chile."
    : "Portfolio of Diego Vergara, full-stack developer and cybersecurity enthusiast based in Santiago, Chile.");

const faviconLight = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, "/");
const faviconDark = `${import.meta.env.BASE_URL}/favicon-dark.svg`.replace(/\/+/g, "/");

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}/og.png`.replace(/\/+/g, "/"), Astro.site).href;

// hreflang alternates
const esUrl = new URL(localizedPath("/", "es"), Astro.site).href;
const enUrl = new URL(localizedPath("/", "en"), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      id="favicon"
      rel="icon"
      type="image/svg+xml"
      href={faviconLight}
      data-light={faviconLight}
      data-dark={faviconDark}
    />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "es" ? "es_CL" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f4f3ef" />

    <!-- No-flash theme init: run before paint. Paper (light) unless the visitor chose dark. -->
    <script is:inline>
      try {
        const dark = localStorage.getItem("theme") === "dark";
        document.documentElement.classList.toggle("dark", dark);
        const icon = document.getElementById("favicon");
        icon.href = dark ? icon.dataset.dark : icon.dataset.light;
      } catch (e) {}
    </script>
  </head>
  <body class="sm:px-6 sm:py-12">
    <div
      class="mx-auto max-w-page bg-surface-raised px-4 py-10 sm:border sm:border-line sm:px-12 sm:py-14 sm:shadow-[0_1px_2px_rgb(0_0_0/0.04)]"
    >
      <slot />
    </div>
  </body>
</html>
