---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="mb-12">
  <p class="mb-2 font-mono text-sm font-medium uppercase tracking-widest text-accent">
    {eyebrow}
  </p>
  <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>
  <div class="mt-4 h-1 w-16 rounded-full bg-accent"></div>
</div>
