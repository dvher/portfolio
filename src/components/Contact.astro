---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { profile, socials } from "../data/portfolio";
import Section from "./Section.astro";
import Icon from "./Icon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="contact" index="05" eyebrow={t("contact.eyebrow")} title={t("contact.title")}>
  <p class="font-serif text-4xl leading-[1.1] text-ink sm:text-5xl">{t("contact.headline")}</p>
  <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">{t("contact.lead")}</p>

  <a
    href={`mailto:${profile.email}`}
    class="group mt-10 flex items-center justify-between gap-4 border-y border-line py-6 text-xl text-ink transition-colors hover:text-accent sm:text-3xl"
  >
    <span class="break-all">{profile.email}</span>
    <Icon
      name="arrow-up-right"
      size={28}
      class="shrink-0 transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"
    />
  </a>

  <div class="mt-10 grid gap-8 sm:grid-cols-2">
    <div>
      <h3 class="label">{t("contact.elsewhere")}</h3>
      <ul class="mt-4 space-y-2">
        {
          socials
            .filter((s) => s.icon !== "email")
            .map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-underline inline-flex items-center gap-2 text-ink"
                >
                  <Icon name={s.icon} size={16} />
                  {s.label}
                </a>
              </li>
            ))
        }
      </ul>
    </div>
    <div>
      <h3 class="label">{t("contact.location")}</h3>
      <p class="mt-4 flex items-center gap-2 text-ink">
        <Icon name="map-pin" size={16} class="text-accent" />
        {t("about.location")}
      </p>
    </div>
  </div>
</Section>
