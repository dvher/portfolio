---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { experience, education } from "../data/portfolio";
import Section from "./Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const startLabel = (job: (typeof experience)[number]) =>
  lang === "en" && job.startEn ? job.startEn : job.start;
---

<Section id="experience" index="02" eyebrow={t("experience.eyebrow")} title={t("experience.title")}>
  <ol class="border-t border-line">
    {
      experience.map((job) => (
        <li class="grid gap-x-8 gap-y-3 border-b border-line py-8 sm:grid-cols-[9rem_1fr]">
          <p class="label pt-1.5">
            {startLabel(job)} — {pick(job.end, lang)}
          </p>
          <div>
            <h3 class="text-2xl font-medium tracking-tight text-ink">{pick(job.role, lang)}</h3>
            <p class="mt-1 text-ink-muted">
              <span class="text-accent">{job.company}</span>
              {job.location && <span> · {job.location}</span>}
            </p>

            <ul class="mt-5 space-y-2.5">
              {job.highlights.map((h) => (
                <li class="grid grid-cols-[1.25rem_1fr] leading-relaxed text-ink-muted">
                  <span class="text-line" aria-hidden="true">
                    —
                  </span>
                  {pick(h, lang)}
                </li>
              ))}
            </ul>

            <div class="tag-list mt-5">
              {job.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="label mt-14">{t("experience.education")}</h3>
  <ul class="mt-4 border-t border-line">
    {
      education.map((edu) => (
        <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 sm:grid-cols-[9rem_1fr]">
          <p class="label pt-1">
            {edu.start} — {pick(edu.end, lang)}
          </p>
          <div>
            <p class="text-lg font-medium text-ink">{pick(edu.degree, lang)}</p>
            <p class="mt-0.5 text-ink-muted">{edu.school}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
