---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { experience, education } from "../data/portfolio";
import Section from "./Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const startLabel = (job: (typeof experience)[number]) =>
  lang === "en" && job.startEn ? job.startEn : job.start;
---

<Section id="experience" title={t("experience.title")}>
  <ol class="space-y-8">
    {
      experience.map((job) => (
        <li>
          <div class="flex flex-col justify-between gap-x-4 sm:flex-row sm:items-baseline">
            <h3 class="font-semibold">
              {pick(job.role, lang)} <span class="font-normal text-ink-muted">@</span>{" "}
              {job.company}
            </h3>
            <p class="shrink-0 text-sm text-ink-muted">
              {startLabel(job)} – {pick(job.end, lang)}
            </p>
          </div>
          {job.location && <p class="text-sm text-ink-muted">{job.location}</p>}

          <ul class="dash-list mt-3 space-y-1">
            {job.highlights.map((h) => (
              <li>{pick(h, lang)}</li>
            ))}
          </ul>

          <div class="tag-list mt-3">
            {job.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="label mt-10">{t("experience.education")}</h3>
  <ul class="mt-4 space-y-4">
    {
      education.map((edu) => (
        <li class="flex flex-col justify-between gap-x-4 sm:flex-row sm:items-baseline">
          <div>
            <p class="font-semibold">{pick(edu.degree, lang)}</p>
            <p class="text-ink-muted">{edu.school}</p>
          </div>
          <p class="shrink-0 text-sm text-ink-muted">
            {edu.start} – {pick(edu.end, lang)}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
