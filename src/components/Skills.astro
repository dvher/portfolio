---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { skills, softSkills } from "../data/portfolio";
import SectionHeading from "./SectionHeading.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groupTitle: Record<string, string> = {
  languages: t("skills.group.languages"),
  frameworks: t("skills.group.frameworks"),
  security: t("skills.group.security"),
};
---

<section id="skills" class="section-anchor border-t border-line py-24">
  <div class="container reveal">
    <SectionHeading eyebrow={t("skills.eyebrow")} title={t("skills.title")} />

    <div class="grid gap-8 md:grid-cols-3">
      {
        skills.map((group) => (
          <div class="rounded-2xl border border-line bg-surface-raised p-6">
            <h3 class="mb-4 font-mono text-sm font-semibold uppercase tracking-widest text-accent">
              {groupTitle[group.key]}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8 rounded-2xl border border-line bg-surface-raised p-6">
      <h3 class="mb-4 font-mono text-sm font-semibold uppercase tracking-widest text-accent">
        {t("skills.group.soft")}
      </h3>
      <div class="flex flex-wrap gap-2">
        {softSkills.map((s) => <span class="chip">{pick(s, lang)}</span>)}
      </div>
    </div>
  </div>
</section>
