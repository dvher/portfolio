---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { skills, softSkills } from "../data/portfolio";
import Section from "./Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groupTitle: Record<string, string> = {
  languages: t("skills.group.languages"),
  frameworks: t("skills.group.frameworks"),
  security: t("skills.group.security"),
};

const rows = [
  ...skills.map((g) => ({ title: groupTitle[g.key], items: g.items })),
  { title: t("skills.group.soft"), items: softSkills.map((s) => pick(s, lang)) },
];
---

<Section id="skills" index="03" eyebrow={t("skills.eyebrow")} title={t("skills.title")}>
  <dl class="border-t border-line">
    {
      rows.map((row) => (
        <div class="grid gap-x-8 gap-y-4 border-b border-line py-7 sm:grid-cols-[9rem_1fr]">
          <dt class="label pt-2">{row.title}</dt>
          <dd class="flex flex-wrap gap-2">
            {row.items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
