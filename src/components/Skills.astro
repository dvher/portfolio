---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { skills, softSkills } from "../data/portfolio";
import Section from "./Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groupTitle: Record<string, string> = {
  languages: t("skills.group.languages"),
  frameworks: t("skills.group.frameworks"),
  databases: t("skills.group.databases"),
  infrastructure: t("skills.group.infrastructure"),
  security: t("skills.group.security"),
};

const rows = [
  ...skills.map((g) => ({ title: groupTitle[g.key], items: g.items })),
  { title: t("skills.group.soft"), items: softSkills.map((s) => pick(s, lang)) },
];
---

<Section id="skills" title={t("skills.title")}>
  <dl class="space-y-3">
    {
      rows.map((row) => (
        <div>
          <dt class="text-ink-muted">{row.title}</dt>
          <dd>{row.items.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</Section>
