---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { profile } from "../data/portfolio";
import Section from "./Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="about" title={t("about.title")}>
  <p>{pick(profile.bio, lang)}</p>

  <ul class="dash-list mt-5 space-y-1 text-ink-muted">
    {profile.facts.map((fact) => <li>{pick(fact, lang)}</li>)}
  </ul>
</Section>
