---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { profile, socials, site } from "../data/portfolio";
import Icon from "./Icon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="pb-10 pt-6">
  <div class="container">
    {
      site.spotifyEmbed && (
        <div class="mb-12 max-w-md">
          <p class="label mb-3">{t("footer.nowPlaying")}</p>
          <iframe
            src={site.spotifyEmbed}
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Spotify"
            class="overflow-hidden rounded-xl"
          />
        </div>
      )
    }

    <p
      class="select-none font-serif text-[clamp(3rem,15vw,12rem)] leading-none tracking-[-0.02em] text-ink/[0.07]"
      aria-hidden="true"
    >
      {profile.name}
    </p>

    <div
      class="mt-6 flex flex-col gap-5 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="label">
        © {year}
        {profile.name} · {t("footer.builtWith")}
      </p>
      <div class="flex items-center gap-5">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.icon === "email" ? undefined : "_blank"}
              rel="noopener noreferrer"
              class="text-ink-muted transition-colors hover:text-accent"
              aria-label={s.label}
              title={s.label}
            >
              <Icon name={s.icon} size={18} />
            </a>
          ))
        }
        <a
          href="#hero"
          class="label inline-flex items-center gap-1.5 transition-colors hover:text-ink"
        >
          <Icon name="arrow-up" size={14} />
          {t("footer.backToTop")}
        </a>
      </div>
    </div>
  </div>
</footer>
