---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { profile, site } from "../data/portfolio";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16">
  {
    site.spotifyEmbed && (
      <div class="mb-10">
        <p class="label mb-3">{t("footer.nowPlaying")}</p>
        <iframe
          src={site.spotifyEmbed}
          width="100%"
          height="152"
          frameborder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="Spotify"
        />
      </div>
    )
  }

  <div
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-line pt-5 text-xs text-ink-muted"
  >
    <p>© {year} {profile.name} · {t("footer.builtWith")}</p>
    <a href="#main" class="transition-colors hover:text-accent">↑ {t("footer.backToTop")}</a>
  </div>
</footer>
