---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { profile, socials, site } from "../data/portfolio";
import Icon from "./Icon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-14">
  <div class="container">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr]">
      <div>
        <a
          href="#hero"
          class="font-mono text-lg font-bold text-ink transition-colors hover:text-accent"
        >
          {profile.name}
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-muted">
          {t("footer.builtWith")}
        </p>
        <div class="mt-5 flex items-center gap-4">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.icon === "email" ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="text-ink-muted transition-colors hover:text-accent"
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} size={20} />
              </a>
            ))
          }
        </div>
      </div>

      {
        site.spotifyEmbed && (
          <div>
            <p class="mb-3 flex items-center gap-2 font-mono text-sm font-semibold uppercase tracking-widest text-ink-muted">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-accent" aria-hidden="true">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.38-1.32 9.78-.66 13.5 1.62.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.66-1.56.36z" />
              </svg>
              {t("footer.nowPlaying")}
            </p>
            <iframe
              src={site.spotifyEmbed}
              width="100%"
              height="152"
              frameborder="0"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
              title="Spotify"
              class="overflow-hidden rounded-xl"
            />
          </div>
        )
      }
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-line pt-6 sm:flex-row"
    >
      <p class="text-sm text-ink-muted">
        © {year} {profile.name}. {t("footer.rights")}
      </p>
      <a
        href="#hero"
        class="inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-accent"
      >
        <Icon name="arrow-up" size={16} />
        {t("footer.backToTop")}
      </a>
    </div>
  </div>
</footer>
