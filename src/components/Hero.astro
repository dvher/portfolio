---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { profile, socials, site } from "../data/portfolio";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const cvHref = `${base}${site.cvPath}`.replace(/\/+/g, "/");
---

<section id="hero" class="mt-14">
  <h1 class="text-2xl font-semibold tracking-tight">{profile.name}</h1>
  <p class="mt-1 text-ink-muted">
    {t("hero.role")}
    {t("hero.and")} · {profile.location}
  </p>

  <p class="mt-6">{t("hero.tagline")}</p>
  <p class="mt-2 text-sm text-ink-muted">→ {t("hero.available")}</p>

  <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    {
      socials.map((s) => (
        <li>
          <a
            href={s.href}
            target={s.icon === "email" ? undefined : "_blank"}
            rel="noopener noreferrer"
            class="link"
          >
            {s.label.toLowerCase()}
          </a>
        </li>
      ))
    }
    <li><a href={cvHref} download class="link">cv.pdf</a></li>
  </ul>
</section>
