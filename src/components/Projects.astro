---
import { getLangFromUrl, useTranslations, pick } from "../i18n/utils";
import { projects, badgeLabels } from "../data/portfolio";
import Section from "./Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = projects.filter((p) => p.featured);
const archive = projects.filter((p) => !p.featured);
const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<Section id="projects" title={t("projects.title")}>
  <p class="text-sm text-ink-muted">{t("projects.note")}</p>

  <ol class="mt-8 space-y-8">
    {
      featured.map((project) => (
        <li>
          <article>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-semibold">
                {project.repo ? (
                  <a href={project.repo} {...ext} class="link">
                    {project.name} ↗
                  </a>
                ) : (
                  project.name
                )}
              </h3>
              {project.year && <span class="shrink-0 text-sm text-ink-muted">{project.year}</span>}
            </div>

            {project.badges && project.badges.length > 0 && (
              <p class="mt-1 text-xs text-ink-muted">
                {project.badges.map((badge) => `[${pick(badgeLabels[badge], lang)}]`).join(" ")}
              </p>
            )}

            <p class="mt-2">{pick(project.description, lang)}</p>

            <div class="tag-list mt-2">
              {project.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>

            {(project.repo || project.live || project.related) && (
              <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
                {project.repo && (
                  <a href={project.repo} {...ext} class="link">
                    {t("projects.viewCode").toLowerCase()} ↗
                  </a>
                )}
                {project.live && (
                  <a href={project.live} {...ext} class="link">
                    {t("projects.viewLive").toLowerCase()} ↗
                  </a>
                )}
                {project.related?.map((r) => (
                  <a href={r.href} {...ext} class="link text-ink-muted">
                    {r.label} ↗
                  </a>
                ))}
              </p>
            )}
          </article>
        </li>
      ))
    }
  </ol>

  {
    archive.length > 0 && (
      <>
        <h3 class="label mt-10">{t("projects.archive")}</h3>
        <ul class="dash-list mt-4 space-y-2">
          {archive.map((project) => {
            const href = project.live ?? project.repo;
            return (
              <li>
                {href ? (
                  <a href={href} {...ext} class="link font-semibold">
                    {project.name}
                  </a>
                ) : (
                  <span class="font-semibold">{project.name}</span>
                )}
                {!href && <span class="text-xs text-ink-muted"> [{t("projects.private").toLowerCase()}]</span>}
                <span class="text-ink-muted"> — {pick(project.description, lang)}</span>
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</Section>
