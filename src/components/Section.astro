---
/*
 * Shared section layout: a small muted heading, then the content.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="section-anchor mt-14">
  <h2 class="label">{title}</h2>
  <div class="mt-4">
    <slot />
  </div>
</section>
