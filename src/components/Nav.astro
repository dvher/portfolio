---
import { getLangFromUrl, useTranslations, getAltLangUrl } from "../i18n/utils";
import { profile } from "../data/portfolio";
import ThemeToggle from "../react/ThemeToggle.tsx";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altUrl = getAltLangUrl(lang);
const otherLang = lang === "es" ? "EN" : "ES";

const links = [
  { href: "#about", label: t("nav.about") },
  { href: "#experience", label: t("nav.experience") },
  { href: "#skills", label: t("nav.skills") },
  { href: "#projects", label: t("nav.projects") },
  { href: "#contact", label: t("nav.contact") },
];

const initials = profile.name
  .split(" ")
  .map((w) => w[0])
  .join("");
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast">
  {t("nav.skipToContent")}
</a>

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-all duration-300"
>
  <nav class="container flex h-16 items-center justify-between gap-4">
    <a
      href="#main"
      class="font-mono text-lg font-bold tracking-tight text-ink transition-colors hover:text-accent"
      aria-label={profile.name}
    >
      <span class="text-accent">&lt;</span>{initials}<span class="text-accent"> /&gt;</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-ink-muted transition-colors hover:text-accent-soft"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={altUrl}
        class="inline-flex h-9 items-center justify-center rounded-lg border border-line bg-surface-raised px-3 font-mono text-xs font-semibold text-ink-muted transition-colors hover:border-accent hover:text-accent"
        aria-label={t("lang.toggle")}
        title={t("lang.toggle")}
      >
        {otherLang}
      </a>
      <ThemeToggle label={t("theme.toggle")} client:load />

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line bg-surface-raised text-ink-muted transition-colors hover:border-accent hover:text-accent md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-surface/95 backdrop-blur md:hidden"
  >
    <ul class="container flex flex-col gap-1 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link block rounded-lg px-3 py-2 text-ink-muted transition-colors hover:bg-surface-raised hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Nav background on scroll
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.classList.add("border-line", "bg-surface/80", "backdrop-blur");
    } else {
      nav.classList.remove("border-line", "bg-surface/80", "backdrop-blur");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const close = () => {
    menu?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
  };
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(open === false));
  });
  document.querySelectorAll(".mobile-link").forEach((el) => el.addEventListener("click", close));
</script>
