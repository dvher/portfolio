---
import { getLangFromUrl, useTranslations, getAltLangUrl } from "../i18n/utils";
import ThemeToggle from "../react/ThemeToggle.tsx";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altUrl = getAltLangUrl(lang);
const otherLang = lang === "es" ? "en" : "es";

const links = [
  { href: "#about", label: t("nav.about") },
  { href: "#experience", label: t("nav.experience") },
  { href: "#projects", label: t("nav.projects") },
  { href: "#contact", label: t("nav.contact") },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-1 focus:text-surface"
>
  {t("nav.skipToContent")}
</a>

<header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 text-sm">
  <ul class="flex flex-wrap gap-x-4 text-ink-muted">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="lowercase transition-colors hover:text-accent">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="flex items-baseline gap-4 text-ink-muted">
    <a
      href={altUrl}
      class="transition-colors hover:text-accent"
      aria-label={t("lang.toggle")}
      title={t("lang.toggle")}
    >
      [{otherLang}]
    </a>
    <ThemeToggle label={t("theme.toggle")} client:load />
  </div>
</header>
