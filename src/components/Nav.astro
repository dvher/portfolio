---
import { getLangFromUrl, useTranslations, getAltLangUrl } from "../i18n/utils";
import { profile } from "../data/portfolio";
import ThemeToggle from "../react/ThemeToggle.tsx";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altUrl = getAltLangUrl(lang);
const otherLang = lang === "es" ? "EN" : "ES";

const links = [
  { href: "#about", label: t("nav.about") },
  { href: "#experience", label: t("nav.experience") },
  { href: "#skills", label: t("nav.skills") },
  { href: "#projects", label: t("nav.projects") },
  { href: "#contact", label: t("nav.contact") },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-surface"
>
  {t("nav.skipToContent")}
</a>

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <nav class="container flex h-16 items-center justify-between gap-4">
    <a
      href="#main"
      class="group flex items-center gap-2.5 text-sm font-semibold tracking-tight text-ink"
      aria-label={profile.name}
    >
      <span class="h-2.5 w-2.5 bg-accent transition-transform group-hover:rotate-45"></span>
      {profile.name}
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link, i) => (
          <li>
            <a
              href={link.href}
              class="group flex items-baseline gap-1.5 text-sm text-ink-muted transition-colors hover:text-ink"
            >
              <span class="font-mono text-[0.65rem] text-ink-muted/70 transition-colors group-hover:text-accent">
                {String(i + 1).padStart(2, "0")}
              </span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={altUrl}
        class="inline-flex h-9 items-center justify-center rounded-full border border-line px-3.5 font-mono text-xs font-medium text-ink-muted transition-colors hover:border-ink hover:text-ink"
        aria-label={t("lang.toggle")}
        title={t("lang.toggle")}
      >
        {otherLang}
      </a>
      <ThemeToggle label={t("theme.toggle")} client:load />

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-muted transition-colors hover:border-ink hover:text-ink md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="9" x2="20" y2="9"></line>
          <line x1="4" y1="15" x2="20" y2="15"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-surface md:hidden">
    <ul class="container flex flex-col py-2">
      {
        links.map((link, i) => (
          <li class="border-b border-line last:border-0">
            <a
              href={link.href}
              class="mobile-link flex items-baseline gap-3 py-3.5 text-lg text-ink transition-colors hover:text-accent"
            >
              <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, "0")}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Nav background on scroll
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.classList.add("border-line", "bg-surface/85", "backdrop-blur-md");
    } else {
      nav.classList.remove("border-line", "bg-surface/85", "backdrop-blur-md");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const close = () => {
    menu?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
  };
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(open === false));
  });
  document.querySelectorAll(".mobile-link").forEach((el) => el.addEventListener("click", close));
</script>
